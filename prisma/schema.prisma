generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled URL (pgbouncer) breaks `prisma migrate deploy`; migrations need the direct host.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  isActive         Boolean  @default(true)
  consultantPayDay Int      @default(11)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  products           Product[]
  sales              Sale[]
  customers          Customer[]
  expenses           Expense[]
  shippingRates      ShippingRate[]
  settings           Setting[]
  stockLogs          StockLog[]
  orderStatusLogs    OrderStatusLog[]
  creditPayments     CreditPayment[]
  debtReminders      DebtReminder[]
  consultants        Consultant[]
  commissionPayments CommissionPayment[]
  consultantStock    ConsultantStock[]
  stockTransfers     StockTransfer[]
  salesTargets       SalesTarget[]
  productGroups      ProductGroup[]
  quotes             Quote[]
  paymentNotes       PaymentNote[]
  riders             Rider[]
  deliveries         Delivery[]
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
}

model Product {
  id              String            @id @default(cuid())
  name            String
  sku             String
  description     String?
  category        String?
  costPrice       Decimal           @db.Decimal(10, 2)
  sellingPrice    Decimal           @db.Decimal(10, 2)
  originalPrice   Decimal?          @db.Decimal(10, 2)
  stock           Int               @default(0)
  reorderLevel    Int               @default(5)
  supplier        String?
  imageUrl        String?
  isActive        Boolean           @default(true)
  groupId         String?
  variantLabel    String?
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  saleItems       SaleItem[]
  stockLogs       StockLog[]
  consultantStock ConsultantStock[]
  stockTransfers  StockTransfer[]
  quoteItems      QuoteItem[]
  group           ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([companyId, sku])
  @@index([companyId, groupId])
}

model ProductGroup {
  id        String    @id @default(cuid())
  name      String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([companyId])
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  change    Int
  reason    String
  saleId    String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, productId])
}

model Sale {
  id              String           @id @default(cuid())
  orderNumber     String
  date            DateTime         @default(now())
  totalPrice      Decimal          @db.Decimal(10, 2)
  shippingCost    Decimal          @default(0) @db.Decimal(10, 2)
  shippingCharge  Decimal          @default(0) @db.Decimal(10, 2)
  discount        Decimal          @default(0) @db.Decimal(10, 2)
  status          String           @default("Pending")
  paymentStatus   String           @default("Unpaid")
  paymentMethod   String?
  source          String?
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerCity    String?
  deliveryAddress String?
  notes           String?
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentType     String           @default("Cash")
  amountPaid      Decimal          @default(0) @db.Decimal(10, 2)
  creditDueDate   DateTime?
  creditNotes     String?
  consultantId    String?
  consultant      Consultant?      @relation(fields: [consultantId], references: [id])
  items           SaleItem[]
  statusHistory   OrderStatusLog[]
  creditPayments  CreditPayment[]
  debtReminders   DebtReminder[]
  paymentNotes    PaymentNote[]
  quote           Quote?
  delivery        Delivery?

  @@unique([companyId, orderNumber])
  @@index([companyId, date])
  @@index([consultantId])
}

model SaleItem {
  id                      String      @id @default(cuid())
  saleId                  String
  sale                    Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product     @relation(fields: [productId], references: [id])
  qty                     Int
  unitPrice               Decimal     @db.Decimal(10, 2)
  costPrice               Decimal     @db.Decimal(10, 2)
  totalPrice              Decimal     @db.Decimal(10, 2)
  serialNumber            String?
  stockSourceConsultantId String?
  stockSourceConsultant   Consultant? @relation("StockSource", fields: [stockSourceConsultantId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model OrderStatusLog {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  fromStatus String
  toStatus   String
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  whatsapp  String?
  city      String?
  email     String?
  source    String?
  notes     String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  sales     Sale[]
  quotes    Quote[]

  @@index([companyId, phone])
}

// Price quotation issued to a customer on request — no stock deduction or commission
// impact until explicitly converted into a real Sale via convertedSaleId.
model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String
  date            DateTime    @default(now())
  expiresAt       DateTime?
  status          String      @default("Sent")
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerCity    String?
  shippingCharge  Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  notes           String?
  consultantId    String?
  consultant      Consultant? @relation(fields: [consultantId], references: [id])
  convertedSaleId String?     @unique
  convertedSale   Sale?       @relation(fields: [convertedSaleId], references: [id])
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, date])
  @@index([consultantId])
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qty        Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@index([quoteId])
  @@index([productId])
}

model Expense {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  category      String
  paymentMethod String?
  isRecurring   Boolean  @default(false)
  frequency     String?
  notes         String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())

  @@index([companyId, date])
}

model ShippingRate {
  id        String  @id @default(cuid())
  city      String
  region    String?
  rate      Decimal @db.Decimal(10, 2)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, city])
}

model Setting {
  id        String  @id @default(cuid())
  key       String
  value     String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model CreditPayment {
  id            String   @id @default(cuid())
  saleId        String
  sale          Sale     @relation(fields: [saleId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String?
  reference     String?
  notes         String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

model DebtReminder {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  channel   String
  message   String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  sentAt    DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

// Timestamped log of payment-position comments on an order (e.g. "will pay tomorrow via
// MoMo", "paid, ref 4521") — an activity trail, not a single overwritable status field.
model PaymentNote {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  note      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

model Consultant {
  id                 String              @id @default(cuid())
  name               String
  phone              String?
  whatsapp           String?
  payType            String              @default("per_unit")
  commissionRate     Decimal             @default(50) @db.Decimal(10, 2)
  tierThreshold      Int                 @default(50)
  tierRate           Decimal             @default(30) @db.Decimal(10, 2)
  monthlyAllowance   Decimal             @default(400) @db.Decimal(10, 2)
  isActive           Boolean             @default(true)
  isStockLocation    Boolean             @default(false)
  startDate          DateTime?
  notes              String?
  userId             String?             @unique
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sales              Sale[]
  commissionPayments CommissionPayment[]
  stock              ConsultantStock[]
  stockTransfers     StockTransfer[]
  saleItemSources    SaleItem[]          @relation("StockSource")
  quotes             Quote[]
}

model CommissionPayment {
  id            String     @id @default(cuid())
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id])
  amount        Decimal    @db.Decimal(10, 2)
  type          String     @default("commission")
  periodFrom    DateTime?
  periodTo      DateTime?
  paymentMethod String?
  reference     String?
  notes         String?
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([consultantId])
  @@index([companyId])
}

model ConsultantStock {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int        @default(0)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  updatedAt    DateTime   @updatedAt

  @@unique([consultantId, productId])
  @@index([companyId])
}

model StockTransfer {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int
  direction    String     @default("to_consultant")
  notes        String?
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([consultantId])
  @@index([companyId])
  @@index([productId])
}

model SalesTarget {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  label         String?
  periodStart   DateTime
  periodEnd     DateTime
  revenueTarget Decimal  @db.Decimal(12, 2)
  savingsRate   Decimal  @default(0.25) @db.Decimal(5, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, periodStart, periodEnd])
}

// A delivery rider. Mirrors the Consultant shape: an optional linked User gives them a login
// that scopes every query to their own runs.
model Rider {
  id         String     @id @default(cuid())
  name       String
  phone      String?
  nrc        String?
  licenceNo  String?
  isActive   Boolean    @default(true)
  startDate  DateTime?
  notes      String?
  userId     String?    @unique
  companyId  String
  company    Company    @relation(fields: [companyId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  deliveries Delivery[]

  @@index([companyId])
}

// One delivery run for one order. Kept apart from Sale because a delivery can be attempted,
// fail and be reassigned without that history touching the order itself.
// status: Assigned -> PickedUp -> Delivered, or Failed at any point.
model Delivery {
  id             String    @id @default(cuid())
  saleId         String    @unique
  sale           Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  riderId        String?
  rider          Rider?    @relation(fields: [riderId], references: [id])
  status         String    @default("Assigned")
  assignedAt     DateTime  @default(now())
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?
  recipientName  String?
  attempts       Int       @default(1)
  notes          String?
  // Money the rider took at the door, and the confirmation that it reached the company.
  cashCollected  Decimal   @default(0) @db.Decimal(10, 2)
  cashRemitted   Boolean   @default(false)
  cashRemittedAt DateTime?
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId, status])
  @@index([riderId, assignedAt])
}
