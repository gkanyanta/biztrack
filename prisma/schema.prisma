generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Neon's pooled URL (pgbouncer) breaks `prisma migrate deploy`; migrations need the direct host.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  isActive         Boolean  @default(true)
  consultantPayDay Int      @default(11)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users              User[]
  products           Product[]
  sales              Sale[]
  customers          Customer[]
  expenses           Expense[]
  shippingRates      ShippingRate[]
  settings           Setting[]
  stockLogs          StockLog[]
  orderStatusLogs    OrderStatusLog[]
  creditPayments     CreditPayment[]
  debtReminders      DebtReminder[]
  consultants        Consultant[]
  commissionPayments CommissionPayment[]
  consultantStock    ConsultantStock[]
  stockTransfers     StockTransfer[]
  salesTargets       SalesTarget[]
  productGroups      ProductGroup[]
  quotes             Quote[]
  paymentNotes       PaymentNote[]
  riders             Rider[]
  deliveries         Delivery[]
  staff              Staff[]
  staffPayments      StaffPayment[]
  riderExpenses      RiderExpense[]
  riderDailyReports  RiderDailyReport[]
  courierRuns        CourierRun[]
  loans              Loan[]
  payAdjustments     PayAdjustment[]
  payRuns            PayRun[]
  payslips           Payslip[]
  payslipLines       PayslipLine[]
  consultantTargets  ConsultantTarget[]
  advanceRequests    AdvanceRequest[]
  orderQueries       OrderQuery[]
  zraConfig          ZraConfig?
  fiscalDocuments    FiscalDocument[]
}

model User {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String
  name      String
  role      String   @default("admin")
  companyId String?
  company   Company? @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  statusChanges      OrderStatusLog[] @relation("StatusChanges")
  deliveriesAssigned Delivery[]       @relation("DeliveriesAssigned")
  salesRecorded      Sale[]           @relation("SalesRecorded")
  runsDispatched     CourierRun[]     @relation("RunsDispatched")
}

model Product {
  id              String            @id @default(cuid())
  name            String
  sku             String
  description     String?
  category        String?
  // Manufacturer brand, for the Meta catalogue feed. Blank means the store-wide fallback applies.
  brand           String?
  // ZRA Smart Invoice: the item classification code ZRA assigns this kind of goods, and a tax
  // category when it differs from the company's default. Only read when Smart Invoice is on.
  zraClassCode    String?
  zraTaxCategory  String?
  // When the item was registered on the company's VSDC; a sale cannot be reported before that.
  zraRegisteredAt DateTime?
  costPrice       Decimal           @db.Decimal(10, 2)
  sellingPrice    Decimal           @db.Decimal(10, 2)
  originalPrice   Decimal?          @db.Decimal(10, 2)
  stock           Int               @default(0)
  reorderLevel    Int               @default(5)
  supplier        String?
  imageUrl        String?
  isActive        Boolean           @default(true)
  groupId         String?
  variantLabel    String?
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  saleItems       SaleItem[]
  stockLogs       StockLog[]
  consultantStock ConsultantStock[]
  stockTransfers  StockTransfer[]
  quoteItems      QuoteItem[]
  group           ProductGroup?     @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([companyId, sku])
  @@index([companyId, groupId])
}

model ProductGroup {
  id        String    @id @default(cuid())
  name      String
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([companyId])
}

model StockLog {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  change    Int
  reason    String
  saleId    String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([companyId, productId])
}

model Sale {
  id              String           @id @default(cuid())
  orderNumber     String
  date            DateTime         @default(now())
  totalPrice      Decimal          @db.Decimal(10, 2)
  shippingCost    Decimal          @default(0) @db.Decimal(10, 2)
  shippingCharge  Decimal          @default(0) @db.Decimal(10, 2)
  discount        Decimal          @default(0) @db.Decimal(10, 2)
  status          String           @default("Pending")
  // How the goods reach the customer. A collection is handed over at the counter, so it
  // never needs a delivery and is genuinely complete the moment it is recorded.
  fulfilment      String           @default("delivery")
  paymentStatus   String           @default("Unpaid")
  paymentMethod   String?
  source          String?
  customerId      String?
  customer        Customer?        @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerCity    String?
  deliveryAddress String?
  notes           String?
  companyId       String
  company         Company          @relation(fields: [companyId], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  paymentType     String           @default("Cash")
  amountPaid      Decimal          @default(0) @db.Decimal(10, 2)
  creditDueDate   DateTime?
  creditNotes     String?
  // Who keyed it in, which is not the same as whose customer it was.
  recordedById    String?
  recordedBy      User?            @relation("SalesRecorded", fields: [recordedById], references: [id])
  consultantId    String?
  consultant      Consultant?      @relation(fields: [consultantId], references: [id])
  items           SaleItem[]
  statusHistory   OrderStatusLog[]
  creditPayments  CreditPayment[]
  debtReminders   DebtReminder[]
  paymentNotes    PaymentNote[]
  quote           Quote?
  delivery        Delivery?
  riderExpenses   RiderExpense[]
  payAdjustments  PayAdjustment[]
  fiscalDocuments FiscalDocument[]
  queries         OrderQuery[]

  @@unique([companyId, orderNumber])
  @@index([companyId, date])
  @@index([consultantId])
  @@index([recordedById])
}

model SaleItem {
  id                      String      @id @default(cuid())
  saleId                  String
  sale                    Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId               String
  product                 Product     @relation(fields: [productId], references: [id])
  qty                     Int
  unitPrice               Decimal     @db.Decimal(10, 2)
  costPrice               Decimal     @db.Decimal(10, 2)
  totalPrice              Decimal     @db.Decimal(10, 2)
  serialNumber            String?
  stockSourceConsultantId String?
  stockSourceConsultant   Consultant? @relation("StockSource", fields: [stockSourceConsultantId], references: [id])

  @@index([saleId])
  @@index([productId])
}

model OrderStatusLog {
  id         String   @id @default(cuid())
  saleId     String
  sale       Sale     @relation(fields: [saleId], references: [id])
  fromStatus String
  toStatus   String
  // Who made the change. Null for everything recorded before actions were attributed, and for
  // the storefront, which has no user behind it.
  byUserId   String?
  byUser     User?    @relation("StatusChanges", fields: [byUserId], references: [id])
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
  @@index([byUserId])
}

model Customer {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  whatsapp  String?
  city      String?
  email     String?
  source    String?
  notes     String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  sales     Sale[]
  quotes    Quote[]

  @@index([companyId, phone])
}

// Price quotation issued to a customer on request — no stock deduction or commission
// impact until explicitly converted into a real Sale via convertedSaleId.
model Quote {
  id              String      @id @default(cuid())
  quoteNumber     String
  date            DateTime    @default(now())
  expiresAt       DateTime?
  status          String      @default("Sent")
  customerId      String?
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerName    String?
  customerPhone   String?
  customerCity    String?
  shippingCharge  Decimal     @default(0) @db.Decimal(10, 2)
  discount        Decimal     @default(0) @db.Decimal(10, 2)
  totalPrice      Decimal     @db.Decimal(10, 2)
  notes           String?
  consultantId    String?
  consultant      Consultant? @relation(fields: [consultantId], references: [id])
  convertedSaleId String?     @unique
  convertedSale   Sale?       @relation(fields: [convertedSaleId], references: [id])
  companyId       String
  company         Company     @relation(fields: [companyId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           QuoteItem[]

  @@unique([companyId, quoteNumber])
  @@index([companyId, date])
  @@index([consultantId])
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  qty        Int
  unitPrice  Decimal @db.Decimal(10, 2)
  totalPrice Decimal @db.Decimal(10, 2)

  @@index([quoteId])
  @@index([productId])
}

model Expense {
  id            String   @id @default(cuid())
  date          DateTime @default(now())
  description   String
  amount        Decimal  @db.Decimal(10, 2)
  category      String
  paymentMethod String?
  isRecurring   Boolean  @default(false)
  frequency     String?
  notes         String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  createdAt     DateTime @default(now())

  // Set when this expense was raised by paying someone, so the pay record owns it.
  staffPayment      StaffPayment?
  commissionPayment CommissionPayment?
  riderExpense      RiderExpense?
  payslip           Payslip?

  @@index([companyId, date])
}

model ShippingRate {
  id        String  @id @default(cuid())
  city      String
  region    String?
  rate      Decimal @db.Decimal(10, 2)
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, city])
}

model Setting {
  id        String  @id @default(cuid())
  key       String
  value     String
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  @@unique([companyId, key])
}

model CreditPayment {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id])
  amount        Decimal   @db.Decimal(10, 2)
  paymentMethod String?
  reference     String?
  notes         String?
  // Set when this payment is the cash a rider collected at the door, posted on remittance.
  // Unique because a delivery remits once; un-ticking the remit deletes this row again.
  deliveryId    String?   @unique
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([saleId])
  @@index([companyId])
}

model DebtReminder {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  channel   String
  message   String?
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  sentAt    DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

// Timestamped log of payment-position comments on an order (e.g. "will pay tomorrow via
// MoMo", "paid, ref 4521") — an activity trail, not a single overwritable status field.
model PaymentNote {
  id        String   @id @default(cuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  note      String
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())

  @@index([saleId])
  @@index([companyId])
}

model Consultant {
  id                   String              @id @default(cuid())
  name                 String
  phone                String?
  whatsapp             String?
  payType              String              @default("per_unit")
  commissionRate       Decimal             @default(50) @db.Decimal(10, 2)
  tierThreshold        Int                 @default(50)
  tierRate             Decimal             @default(30) @db.Decimal(10, 2)
  monthlyAllowance     Decimal             @default(400) @db.Decimal(10, 2)
  isActive             Boolean             @default(true)
  isStockLocation      Boolean             @default(false)
  startDate            DateTime?
  notes                String?
  userId               String?             @unique
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id])
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  sales                Sale[]
  commissionPayments   CommissionPayment[]
  stock                ConsultantStock[]
  stockTransfers       StockTransfer[]
  saleItemSources      SaleItem[]          @relation("StockSource")
  quotes               Quote[]
  dispatchedDeliveries Delivery[]          @relation("DispatchedDeliveries")
  loans                Loan[]
  payAdjustments       PayAdjustment[]
  payslips             Payslip[]
  targets              ConsultantTarget[]
  advanceRequests      AdvanceRequest[]
  orderQueries         OrderQuery[]
}

model CommissionPayment {
  id            String     @id @default(cuid())
  consultantId  String
  consultant    Consultant @relation(fields: [consultantId], references: [id])
  amount        Decimal    @db.Decimal(10, 2)
  type          String     @default("commission")
  periodFrom    DateTime?
  periodTo      DateTime?
  paymentMethod String?
  reference     String?
  notes         String?
  // The Salaries & Wages expense this payment raised; null for advances (see StaffPayment).
  expenseId     String?    @unique
  expense       Expense?   @relation(fields: [expenseId], references: [id])
  // Set when this is cash paid against a finalised payslip. The wage cost was booked when the
  // cycle was finalised, so a payslip payment raises no expense of its own.
  payslipId     String?
  payslip       Payslip?   @relation(fields: [payslipId], references: [id])
  companyId     String
  company       Company    @relation(fields: [companyId], references: [id])
  createdAt     DateTime   @default(now())

  @@index([consultantId])
  @@index([payslipId])
  @@index([companyId])
}

// Salaried staff — the people who are paid a fixed monthly wage rather than commission.
// Deliberately NOT the Consultant table: a Consultant row is selectable as the source of a
// sale and as a stock location, and an inventory clerk or a rider must never appear there.
model Staff {
  id               String           @id @default(cuid())
  name             String
  phone            String?
  jobTitle         String?
  monthlySalary    Decimal          @default(0) @db.Decimal(10, 2)
  // Communication allowance, paid monthly and capped the way a consultant's is.
  monthlyAllowance Decimal          @default(100) @db.Decimal(10, 2)
  isActive         Boolean          @default(true)
  startDate        DateTime?
  notes            String?
  // The login they use, and the rider profile if this person also makes deliveries.
  userId           String?          @unique
  riderId          String?          @unique
  companyId        String
  company          Company          @relation(fields: [companyId], references: [id])
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payments         StaffPayment[]
  loans            Loan[]
  payAdjustments   PayAdjustment[]
  payslips         Payslip[]
  advanceRequests  AdvanceRequest[]

  @@index([companyId])
}

// Money actually handed to a staff member. Mirrors CommissionPayment so the two read the
// same way on the payroll screen: salary and allowance are earnings, an advance is a loan
// against future pay and nets off what is owed.
model StaffPayment {
  id            String    @id @default(cuid())
  staffId       String
  staff         Staff     @relation(fields: [staffId], references: [id])
  amount        Decimal   @db.Decimal(10, 2)
  type          String    @default("salary")
  periodFrom    DateTime?
  periodTo      DateTime?
  paymentMethod String?
  reference     String?
  notes         String?
  // The Salaries & Wages expense this payment raised, so the P&L entry can be undone with it.
  // Null for advances, which are not a cost until the pay they anticipate is earned.
  expenseId     String?   @unique
  expense       Expense?  @relation(fields: [expenseId], references: [id])
  // Cash paid against a finalised payslip — see CommissionPayment.payslipId.
  payslipId     String?
  payslip       Payslip?  @relation(fields: [payslipId], references: [id])
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([staffId])
  @@index([payslipId])
  @@index([companyId])
}

// A loan to someone the company pays: a phone bought on credit, cash lent against future pay.
// Only the terms live here. What has been recovered is the sum of the payslip lines that point
// at the loan, so the balance cannot drift from the pay record.
model Loan {
  id               String          @id @default(cuid())
  consultantId     String?
  consultant       Consultant?     @relation(fields: [consultantId], references: [id])
  staffId          String?
  staff            Staff?          @relation(fields: [staffId], references: [id])
  description      String
  principal        Decimal         @db.Decimal(10, 2)
  // Taken from each pay run, starting with firstPeriod, until the principal is covered.
  instalmentAmount Decimal         @db.Decimal(10, 2)
  firstPeriod      String
  issuedAt         DateTime        @default(now())
  // active | cancelled. A cancelled loan is written off: nothing more is deducted.
  status           String          @default("active")
  notes            String?
  companyId        String
  company          Company         @relation(fields: [companyId], references: [id])
  createdAt        DateTime        @default(now())
  adjustments      PayAdjustment[]
  lines            PayslipLine[]
  advanceRequest   AdvanceRequest?

  @@index([companyId])
  @@index([consultantId])
  @@index([staffId])
}

// Something the admin adds to one person's pay for one cycle, outside what the system works
// out by itself:
//   bonus            extra pay
//   deduction        a one-off deduction
//   recovery         money taken for an order that went wrong (delivery cost for goods that
//                    came back unpaid, the full order for goods that were lost) or held until
//                    the consultant settles something. refundable marks money that goes back
//                    when the order is paid or the hold is released.
//   loan_instalment  "this cycle take exactly this much for this loan" (zero skips it)
// It is applied when a finalised payslip line points at it.
model PayAdjustment {
  id           String        @id @default(cuid())
  consultantId String?
  consultant   Consultant?   @relation(fields: [consultantId], references: [id])
  staffId      String?
  staff        Staff?        @relation(fields: [staffId], references: [id])
  period       String
  kind         String
  amount       Decimal       @db.Decimal(10, 2)
  reason       String?
  saleId       String?
  sale         Sale?         @relation(fields: [saleId], references: [id])
  refundable   Boolean       @default(false)
  // Set when the admin releases held money by hand; it is refunded in this cycle's pay run.
  refundPeriod String?
  loanId       String?
  loan         Loan?         @relation(fields: [loanId], references: [id])
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id])
  createdAt    DateTime      @default(now())
  lines        PayslipLine[]

  @@index([companyId, period])
  @@index([consultantId])
  @@index([staffId])
}

// What a consultant is asked to bring in over one pay cycle, and what reaching it pays.
// Measured the way commission is: goods value actually collected on the cycle's orders. The
// bonus is the flat amount plus a share of whatever is collected beyond the target, and it
// reaches the consultant as a line on that cycle's payslip.
model ConsultantTarget {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  period       String
  target       Decimal    @db.Decimal(12, 2)
  bonus        Decimal    @default(0) @db.Decimal(10, 2)
  // Percent of the collected goods value above the target.
  bonusRate    Decimal    @default(0) @db.Decimal(5, 2)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  createdAt    DateTime   @default(now())

  @@unique([consultantId, period])
  @@index([companyId, period])
}

// A finalised pay cycle. A row exists only once the cycle is finalised: until then the run is
// worked out live, and afterwards its payslips never change.
model PayRun {
  id          String    @id @default(cuid())
  // The cycle label, e.g. "2026-11": the month the cycle closes and is paid.
  period      String
  periodFrom  DateTime
  periodTo    DateTime
  finalisedAt DateTime  @default(now())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id])
  payslips    Payslip[]

  @@unique([companyId, period])
}

// One person's pay for one finalised cycle:
//   netPay = broughtForward + earnings - alreadyPaid - deductions
// What is still outstanding (netPay less the payments made against it) is the next cycle's
// brought forward, negative when the person owes the company.
model Payslip {
  id                 String              @id @default(cuid())
  payRunId           String
  payRun             PayRun              @relation(fields: [payRunId], references: [id])
  consultantId       String?
  consultant         Consultant?         @relation(fields: [consultantId], references: [id])
  staffId            String?
  staff              Staff?              @relation(fields: [staffId], references: [id])
  name               String
  jobTitle           String?
  broughtForward     Decimal             @default(0) @db.Decimal(10, 2)
  earnings           Decimal             @default(0) @db.Decimal(10, 2)
  alreadyPaid        Decimal             @default(0) @db.Decimal(10, 2)
  deductions         Decimal             @default(0) @db.Decimal(10, 2)
  netPay             Decimal             @default(0) @db.Decimal(10, 2)
  // The cycle's wage cost that was not already booked by a payment made during the cycle.
  expenseId          String?             @unique
  expense            Expense?            @relation(fields: [expenseId], references: [id])
  companyId          String
  company            Company             @relation(fields: [companyId], references: [id])
  createdAt          DateTime            @default(now())
  lines              PayslipLine[]
  commissionPayments CommissionPayment[]
  staffPayments      StaffPayment[]

  @@unique([payRunId, consultantId])
  @@unique([payRunId, staffId])
  @@index([companyId])
}

// One row of a payslip. amount is signed: earnings are positive, deductions negative.
model PayslipLine {
  id           String         @id @default(cuid())
  payslipId    String
  payslip      Payslip        @relation(fields: [payslipId], references: [id], onDelete: Cascade)
  kind         String
  label        String
  amount       Decimal        @db.Decimal(10, 2)
  // For commission lines: the cycle the orders belong to, and the total commission those
  // orders had earned when this line was written. The next run pays only what has been
  // earned beyond that figure, which is how money collected late reaches a later payslip.
  sourcePeriod String?
  entitlement  Decimal?       @db.Decimal(10, 2)
  loanId       String?
  loan         Loan?          @relation(fields: [loanId], references: [id])
  adjustmentId String?
  adjustment   PayAdjustment? @relation(fields: [adjustmentId], references: [id])
  sort         Int            @default(0)
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id])

  @@index([payslipId])
  @@index([companyId, loanId])
  @@index([companyId, adjustmentId])
}

model ConsultantStock {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int        @default(0)
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  updatedAt    DateTime   @updatedAt

  @@unique([consultantId, productId])
  @@index([companyId])
}

model StockTransfer {
  id           String     @id @default(cuid())
  consultantId String
  consultant   Consultant @relation(fields: [consultantId], references: [id])
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  qty          Int
  direction    String     @default("to_consultant")
  notes        String?
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  createdAt    DateTime   @default(now())

  @@index([consultantId])
  @@index([companyId])
  @@index([productId])
}

model SalesTarget {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  label         String?
  periodStart   DateTime
  periodEnd     DateTime
  revenueTarget Decimal  @db.Decimal(12, 2)
  savingsRate   Decimal  @default(0.25) @db.Decimal(5, 4)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([companyId, periodStart, periodEnd])
}

// A delivery rider. Mirrors the Consultant shape: an optional linked User gives them a login
// that scopes every query to their own runs.
model Rider {
  id           String             @id @default(cuid())
  name         String
  phone        String?
  nrc          String?
  licenceNo    String?
  // What they carry deliveries in. The model is named Rider because it was built for a motorbike,
  // but what it represents is our own delivery capacity — which includes the owner in a car, and
  // calling him a rider in the screens was simply wrong.
  vehicle      String?
  isActive     Boolean            @default(true)
  startDate    DateTime?
  notes        String?
  userId       String?            @unique
  companyId    String
  company      Company            @relation(fields: [companyId], references: [id])
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deliveries   Delivery[]
  expenses     RiderExpense[]
  dailyReports RiderDailyReport[]
  courierRuns  CourierRun[]

  @@index([companyId])
}

// One delivery run for one order. Kept apart from Sale because a delivery can be attempted,
// fail and be reassigned without that history touching the order itself.
// status: Assigned -> PickedUp -> Delivered, or Failed at any point.
// What the rider spent out of his own pocket on the company's behalf — a Platinum courier fee,
// fuel, airtime. Settlement is net: he hands over collections minus these, so an unsettled
// expense reduces what he owes rather than triggering a separate reimbursement.
// A courier run is one trip to one courier at one of the day's sessions. Parcels for out of town
// go to Platinum rather than on the bike, and batching them into sessions is the whole point:
// one trip with seven parcels instead of seven trips.
//
// Payment comes after dispatch, not before. The receipt Platinum gives for each parcel is sent
// to the customer as proof it is on its way, and only then do they pay — so a dispatched parcel
// is money owed, and the run is where that debt starts rather than where the job ends.
model CourierRun {
  id             String     @id @default(cuid())
  // Which session: the morning, afternoon or day-end run.
  slot           String
  scheduledFor   DateTime
  courier        String     @default("Platinum")
  riderId        String?
  rider          Rider?     @relation(fields: [riderId], references: [id])
  status         String     @default("Open")
  dispatchedAt   DateTime?
  dispatchedById String?
  dispatchedBy   User?      @relation("RunsDispatched", fields: [dispatchedById], references: [id])
  notes          String?
  companyId      String
  company        Company    @relation(fields: [companyId], references: [id])
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deliveries     Delivery[]

  // One run per courier per session per day, so adding a parcel finds the run rather than
  // inventing a second one beside it.
  @@unique([companyId, scheduledFor, courier])
  @@index([companyId, status])
}

model RiderExpense {
  id              String            @id @default(cuid())
  riderId         String
  rider           Rider             @relation(fields: [riderId], references: [id])
  date            DateTime          @default(now())
  category        String
  amount          Decimal           @db.Decimal(10, 2)
  description     String?
  // Set when the rider dropped a parcel at a courier and the fee went onto the order's
  // shippingCost. That figure is already inside gross profit, so settling such an expense must
  // not raise a second one — the company owes him the money, not the books twice.
  onSaleShipping  Boolean           @default(false)
  // Some of these get billed on to the customer. Kept deliberately manual: the amount billed
  // is a judgement call and is sometimes waived, so nothing is charged without someone saying so.
  rechargeable    Boolean           @default(false)
  saleId          String?
  sale            Sale?             @relation(fields: [saleId], references: [id])
  rechargedAt     DateTime?
  rechargedAmount Decimal?          @db.Decimal(10, 2)
  // Set once the office has accounted for the money, which under net settlement means it has
  // been offset against cash he handed over.
  settledAt       DateTime?
  // The company expense this raised. Only once it is a real cost — money still expected back
  // from a customer is not one.
  expenseId       String?           @unique
  expense         Expense?          @relation(fields: [expenseId], references: [id])
  reportId        String?
  report          RiderDailyReport? @relation(fields: [reportId], references: [id])
  companyId       String
  company         Company           @relation(fields: [companyId], references: [id])
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([riderId, date])
  @@index([companyId, settledAt])
}

// The rider's own account of a day, submitted from his phone. Every figure here is what he
// says happened; the screen puts the system's own count beside it, because the gap between the
// two is the thing worth looking at.
model RiderDailyReport {
  id                  String         @id @default(cuid())
  riderId             String
  rider               Rider          @relation(fields: [riderId], references: [id])
  date                DateTime       @db.Date
  deliveriesCompleted Int            @default(0)
  deliveriesFailed    Int            @default(0)
  cashCollected       Decimal        @default(0) @db.Decimal(10, 2)
  expensesPaid        Decimal        @default(0) @db.Decimal(10, 2)
  cashHandedOver      Decimal        @default(0) @db.Decimal(10, 2)
  // What he still has in his pocket, so tomorrow opens from a known figure.
  closingFloat        Decimal        @default(0) @db.Decimal(10, 2)
  submittedAt         DateTime       @default(now())
  acknowledgedAt      DateTime?
  companyId           String
  company             Company        @relation(fields: [companyId], references: [id])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  expenses            RiderExpense[]

  @@unique([riderId, date])
  @@index([companyId, date])
}

model Delivery {
  id                         String      @id @default(cuid())
  saleId                     String      @unique
  sale                       Sale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  // Who actually carried it. A rider is ours and costs a fixed wage and bike hire whatever he
  // does; Yango and the like are hired per trip, and that fare sits on the order's shippingCost
  // like any other delivery cost. A hired courier has no riderId.
  courier                    String      @default("rider")
  // Whatever identifies the trip — a Yango reference, a driver, a plate.
  courierRef                 String?
  // The run this parcel went out on, and the courier's receipt for it — the receipt is what the
  // customer is sent as proof of dispatch, and what they pay against.
  courierRunId               String?
  courierRun                 CourierRun? @relation(fields: [courierRunId], references: [id])
  courierReceiptNo           String?
  // Where the goods physically left from. Null means the warehouse; set means that consultant
  // handed them over out of their own stock, which is a dispatch nobody at the warehouse saw.
  dispatchedFromConsultantId String?
  dispatchedFromConsultant   Consultant? @relation("DispatchedDeliveries", fields: [dispatchedFromConsultantId], references: [id])
  riderId                    String?
  rider                      Rider?      @relation(fields: [riderId], references: [id])
  status                     String      @default("Assigned")
  // Who dispatched it. The warehouse and the office both assign runs, and which one did it
  // is exactly what could not be answered before.
  assignedById               String?
  assignedBy                 User?       @relation("DeliveriesAssigned", fields: [assignedById], references: [id])
  assignedAt                 DateTime    @default(now())
  pickedUpAt                 DateTime?
  deliveredAt                DateTime?
  failedAt                   DateTime?
  failureReason              String?
  recipientName              String?
  attempts                   Int         @default(1)
  notes                      String?
  // Money the rider took at the door, and the confirmation that it reached the company.
  cashCollected              Decimal     @default(0) @db.Decimal(10, 2)
  cashRemitted               Boolean     @default(false)
  cashRemittedAt             DateTime?
  companyId                  String
  company                    Company     @relation(fields: [companyId], references: [id])
  createdAt                  DateTime    @default(now())
  updatedAt                  DateTime    @updatedAt

  // The ledger entry created when the office confirmed this cash arrived.
  remitPayment CreditPayment?

  @@index([companyId, status])
  @@index([riderId, assignedAt])
  @@index([companyId, courier])
  @@index([dispatchedFromConsultantId])
  @@index([assignedById])
  @@index([courierRunId])
}

// A salary advance someone asks for themselves, with how many pay days it is to come back over.
// Paying it out turns it into a Loan, which the pay run already deducts; the first instalment
// comes from the first pay day after the money was handed over, never one before.
model AdvanceRequest {
  id                  String      @id @default(cuid())
  consultantId        String?
  consultant          Consultant? @relation(fields: [consultantId], references: [id])
  staffId             String?
  staff               Staff?      @relation(fields: [staffId], references: [id])
  // The login that asked, which is the person themselves.
  requestedById       String
  amount              Decimal     @db.Decimal(10, 2)
  instalments         Int
  reason              String
  // pending | approved | declined | withdrawn | paid
  status              String      @default("pending")
  // What the admin agreed to, if it differs from what was asked.
  approvedAmount      Decimal?    @db.Decimal(10, 2)
  approvedInstalments Int?
  decisionNote        String?
  decidedAt           DateTime?
  paidAt              DateTime?
  paymentMethod       String?
  loanId              String?     @unique
  loan                Loan?       @relation(fields: [loanId], references: [id])
  companyId           String
  company             Company     @relation(fields: [companyId], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([companyId, status])
  @@index([consultantId])
  @@index([staffId])
}

// ZRA Smart Invoice, per company. No row, or enabled false, and BizTrack never talks to ZRA for
// that company. Only the platform superadmin edits this: it holds where BizTrack sends invoices,
// and a company admin must not be able to point that somewhere else.
model ZraConfig {
  id                       String    @id @default(cuid())
  companyId                String    @unique
  company                  Company   @relation(fields: [companyId], references: [id])
  enabled                  Boolean   @default(false)
  // sandbox | production — shown on screen so nobody mistakes test invoices for real ones.
  environment              String    @default("sandbox")
  // The company's VSDC, e.g. https://vsdc.example.com/zravsdc. Its host must also be listed in
  // the ZRA_ALLOWED_HOSTS environment variable.
  vsdcUrl                  String?
  tpin                     String?
  branchId                 String    @default("000")
  deviceSerial             String?
  // A | C1 | C2 | C3 | D | E | TOT — what a product with no category of its own is taxed under.
  defaultTaxCategory       String?
  // Sales dated before this are history and are never sent.
  startDate                DateTime?
  qtyUnitCode              String    @default("U")
  pkgUnitCode              String    @default("NT")
  originCountry            String?
  deliveryClassCode        String?
  deliveryRegisteredAt     DateTime?
  refundReasonCode         String?
  initialisedAt            DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

// One invoice, or one credit note, as reported to ZRA. The sale is the source of the figures;
// this records what was sent and what ZRA gave back to print on the receipt.
model FiscalDocument {
  id            String    @id @default(cuid())
  saleId        String
  sale          Sale      @relation(fields: [saleId], references: [id])
  // invoice | credit_note
  kind          String
  // pending (not sent yet, or the VSDC could not be reached) | failed (ZRA refused it, or
  // something has to be fixed first) | issued
  status        String    @default("pending")
  invoiceNo     String
  attempts      Int       @default(0)
  lastError     String?
  lastAttemptAt DateTime?
  // Held while one request is sending it, so two cannot report the same invoice twice.
  lockedUntil   DateTime?
  request       Json?
  issuedAt      DateTime?
  rcptNo        Int?
  sdcId         String?
  mrcNo         String?
  intrlData     String?
  rcptSign      String?
  receiptDate   String?
  qrCodeUrl     String?
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([saleId, kind])
  @@unique([companyId, invoiceNo])
  @@index([companyId, status])
}

// The office asking a consultant what is happening with an order, and the conversation that
// follows. One thread per order at a time; it is addressed to the order's consultant, who is
// the only one besides the office who can read or answer it.
model OrderQuery {
  id           String              @id @default(cuid())
  saleId       String
  sale         Sale                @relation(fields: [saleId], references: [id], onDelete: Cascade)
  consultantId String
  consultant   Consultant          @relation(fields: [consultantId], references: [id])
  // open: waiting on the consultant · answered: waiting on the office · closed
  status       String              @default("open")
  raisedById   String
  closedAt     DateTime?
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  messages     OrderQueryMessage[]

  @@index([companyId, status])
  @@index([consultantId, status])
  @@index([saleId])
}

model OrderQueryMessage {
  id         String     @id @default(cuid())
  queryId    String
  query      OrderQuery @relation(fields: [queryId], references: [id], onDelete: Cascade)
  // Who wrote it, kept by name too so the thread still reads right if the login goes.
  authorId   String
  authorName String
  // admin | consultant
  authorRole String
  message    String
  createdAt  DateTime   @default(now())

  @@index([queryId])
}
